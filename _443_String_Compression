// In c++
class Solution {
public:
    int compress(vector<char>& chars) {
        int i = 0;
        int k = 0;
        while(i<chars.size()){
            int count =0;
            char current = chars[i];
            while(i<chars.size() && chars[i]==current){
                count++;
                i++;
            }
            chars[k]=current;
            k++;
            if(count>1){
                string s = to_string(count);
                for(char c : s){
                    chars[k]=c;
                    k++;
                }
            }
        }
        return k;
    }
};


# In Python 
class Solution:
    def compress(self, chars: List[str]) -> int:
        i = 0
        k = 0
        while(i<len(chars)):
            current = chars[i]
            count = 0
            while(i<len(chars) and chars[i]==current):
                count+=1
                i+=1
            chars[k]=chars[i] 
            k+=1
            if(count>1):
                string s = to_string(count)
                for(char c : s):
                    chars[k]=c
                    k+=1
        return k  
