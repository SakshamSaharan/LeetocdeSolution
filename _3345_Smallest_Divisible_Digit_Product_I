class Solution {
public:
    int smallestNumber(int n, int t) {
        int i=n;
        while(i>=n){
            int j = i;
            int mult=1;
            while(j>0){
                int y=j%10;
                mult*=y;
                j/=10;
            }
            if(mult%t==0){
                break;
            }
            i++;
        }
        return i;
    }
};
