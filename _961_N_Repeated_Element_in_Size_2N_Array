// c++ solution 
class Solution {
public:
    int repeatedNTimes(vector<int>& nums) {
        unordered_set<int> s;
        for(int x : nums){
            if(s.count(x)){
                return x;
            }
            s.insert(x);
        }
        return -1;
    }
};

# Python solution
class Solution:
    def repeatedNTimes(self, nums: List[int]) -> int:
        s = {-1}
        for i in nums:
            if(i in s):
                return i
            s.add(i)
        return -1        
