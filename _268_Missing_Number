// c++ solution
class Solution {
public:
    int missingNumber(vector<int>& nums) {
        int n = nums.size();
        vector<int>frequency(n+1,0);
        for(int i=0;i<nums.size();i++){
            frequency[nums[i]]++;
        }
        for(int i=0;i<frequency.size();i++){
            if(frequency[i]<1){
                return i;
            }
        }
        return -1;
    }
};
