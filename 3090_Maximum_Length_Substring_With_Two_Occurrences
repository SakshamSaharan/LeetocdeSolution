// c++ code 
class Solution {
public:
    int maximumLengthSubstring(string s) {
        int left = 0;
        int ans = 0 ;
        vector<int>frequency(26,0);
        for(int right = 0;right<s.size();right++){
            frequency[s[right]-'a']++;
                while(frequency[s[right]-'a']>2){
                    frequency[s[left]-'a']--;
                    left++;
                }
            ans = max(ans,right-left+1);    
        }
        return ans;
    }
};
// js code
/**
 * @param {string} s
 * @return {number}
 */
var maximumLengthSubstring = function(s) {
    let left =0
    let ans =0
   let frequency = new Array(26).fill(0)
    for(let i =0;i<s.length;i++){
        frequency[s[i].charCodeAt(0) - 97]++
        while(frequency[s[i].charCodeAt(0) - 97]>2){
            frequency[s[left].charCodeAt(0) - 97]--
            left++
        }
        ans = Math.max(ans,i-left+1)
    }
    return ans
};
