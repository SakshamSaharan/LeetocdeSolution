class Solution {
public:
    int maximumLengthSubstring(string s) {
        int left = 0;
        int ans = 0 ;
        vector<int>frequency(26,0);
        for(int right = 0;right<s.size();right++){
            frequency[s[right]-'a']++;
                while(frequency[s[right]-'a']>2){
                    frequency[s[left]-'a']--;
                    left++;
                }
            ans = max(ans,right-left+1);    
        }
        return ans;
    }
};
